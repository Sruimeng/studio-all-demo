{
  "name": "@tripo3d/color-quantization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal single-texture color quantization CPU kernel and module-worker client",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./worker": { "types": "./worker.d.ts", "import": "./worker.js" }
  },
  "files": ["index.js", "index.d.ts", "worker.js", "worker.d.ts", "worker-entry.js", "src/*.js", "vendor/*.js", "README.md", "UPSTREAM.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:types": "node ../../node_modules/typescript/bin/tsc -p test/types/tsconfig.json"
  },
  "engines": { "node": ">=20" }
}
